# Local observability stack only. Copy to .env.observability (git-ignored).
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
# HS256 needs >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=
GRAFANA_ADMIN_PASSWORD=change-me
# OpenAI is always replaced by the local WireMock mock (no API key needed).
# Optional resource limits (defaults roughly mimic a small EC2 instance)
# BACKEND_CPUS=2
# BACKEND_MEM_LIMIT=768m
# MYSQL_MEM_LIMIT=512m
